{
  "name": "@notharshhaa/devops-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.NotHarshhaa/devops-mcp",
  "description": "Unified MCP server for DevOps engineers — query and manage Kubernetes, ArgoCD, Prometheus, and PagerDuty from any MCP-compatible AI agent.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "devops-mcp": "./dist/index.js",
    "devops-mcp-sse": "./dist/sse-entry.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:sse": "node dist/sse-entry.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kubernetes",
    "argocd",
    "prometheus",
    "pagerduty",
    "devops",
    "claude"
  ],
  "author": "DevOps MCP Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotHarshhaa/devops-mcp"
  },
  "homepage": "https://github.com/NotHarshhaa/devops-mcp#readme",
  "bugs": {
    "url": "https://github.com/NotHarshhaa/devops-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@kubernetes/client-node": "^1.4.0",
    "node-fetch": "^3.3.2",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "@types/express": "^4.17.14",
    "typescript": "^5.5.3",
    "tsx": "^4.16.2",
    "zod": "^3.23.8",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
