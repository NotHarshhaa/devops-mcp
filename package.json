{
  "name": "@notharshhaa/devops-mcp",
  "version": "2.1.0",
  "mcpName": "io.github.NotHarshhaa/devops-mcp",
  "description": "Unified MCP server for DevOps engineers — query and manage Kubernetes, ArgoCD, Prometheus, and PagerDuty from any MCP-compatible AI agent.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "devops-mcp": "./dist/index.js",
    "devops-mcp-http": "./dist/sse-entry.js",
    "devops-mcp-sse": "./dist/sse-entry.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/sse-entry.js",
    "start:sse": "node dist/sse-entry.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kubernetes",
    "argocd",
    "prometheus",
    "pagerduty",
    "devops",
    "claude"
  ],
  "author": "DevOps MCP Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotHarshhaa/devops-mcp"
  },
  "homepage": "https://github.com/NotHarshhaa/devops-mcp#readme",
  "bugs": {
    "url": "https://github.com/NotHarshhaa/devops-mcp/issues"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
